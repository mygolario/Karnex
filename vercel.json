{
  "buildCommand": "prisma generate && next build && npm run serwist:build",
  "framework": "nextjs",
  "regions": ["cdg1"],
  "functions": {
    "app/api/ai-generate/route.ts": {
      "maxDuration": 120
    },
    "app/api/copilot/route.ts": {
      "maxDuration": 120
    },
    "app/api/workforce/dispatch/route.ts": {
      "maxDuration": 90
    },
    "app/api/cron/night-shift/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/night-shift",
      "schedule": "30 20 * * *"
    }
  ]
}
